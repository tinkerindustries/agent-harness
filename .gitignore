# Secrets
.env
.env.*
!.env.example

# Go
/bin/
/deepseek-harness
/harness
*.test
*.out

# Node / frontend
node_modules/
dist/
.vite/

# The embedded frontend is build output and is not committed. The directory
# itself is, holding only .gitkeep, because go:embed will not compile against
# a missing one. A binary built without running `npm --prefix web run build`
# first therefore compiles and serves nothing.
!internal/webassets/dist/
internal/webassets/dist/*
!internal/webassets/dist/.gitkeep

# Session store
*.db
*.db-shm
*.db-wal
*.sqlite
/data/

# Bind mount for the harness container's workspace root, dev stack then prod.
/workspaces/*
!/workspaces/.gitkeep
/workspaces-prod/*
!/workspaces-prod/.gitkeep

# macOS
.DS_Store

# tsc -b incremental build cache: regenerated by every build, and a
# tracked copy conflicts between any two branches that both ran the build.
web/tsconfig.tsbuildinfo

/.playwright-cli

# git worktrees and their per-worktree environment (docs/wt.md). Both the
# directory the worktrees live in and the descriptor `wt init` writes at each
# worktree's root: per-worktree, per-machine state, never committed.
# .env itself is already covered by the Secrets rule above.
/.claude/worktrees/
wt-env.json

# Skill-development scratch: eval iterations written beside a skill while it is
# being built. Generated, never source — and while untracked it makes the tree
# dirty, which blocks `scripts/prod.sh promote` and stamps any forced build
# `-dirty` (RELEASE.md).
.claude/skills/*-workspace/
.worktree-env.xml

# Python bytecode from the .claude/skills maintenance scripts
__pycache__/
*.pyc
