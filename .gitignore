# Secrets
.env
.env.*
!.env.example

# Go
/bin/
/deepseek-harness
/harness
# What a plain `go build ./cmd/harness` writes on Windows: the same binary as
# /harness above, under the name the platform requires to execute it.
/harness.exe
*.test
*.out

# Session store
*.db
*.db-shm
*.db-wal
*.sqlite
/data/

# macOS
.DS_Store

/.playwright-cli

# Skill-development scratch: eval iterations written beside a skill while it
# is being built. Generated, never source.
.claude/skills/*-workspace/

# Python bytecode from the .claude/skills maintenance scripts
__pycache__/
*.pyc
