# Secrets
.env
.env.*
!.env.example

# Go
/bin/
/deepseek-harness
*.test
*.out

# Node / frontend
node_modules/
dist/
.vite/

# The embedded frontend is build output, and it is committed anyway: go:embed
# will not compile without it, so a clean clone could not build the binary.
# Rebuild with `npm --prefix web run build` before `go build`.
!internal/webassets/dist/

# Session store
*.db
*.db-shm
*.db-wal
*.sqlite
/data/

# Bind mount for the harness container's workspace root.
/workspaces/*
!/workspaces/.gitkeep

# macOS
.DS_Store
