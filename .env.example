# Copy to .env and fill in. .env is gitignored.
# Key from https://platform.deepseek.com/api_keys — prepaid, needs balance.
DEEPSEEK_API_KEY=sk-...

# Optional overrides. Defaults are in docs/MODELS.md.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_EFFORT=high
# DEEPSEEK_THINKING=true
# DEEPSEEK_MAX_TOKENS=48000

# Price table. Never compiled in — see docs/DESIGN.md §4.9.
# DEEPSEEK_PRICE_TABLE=configs/prices.json

# Phase 2: the agent loop (`harness run`).
# DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
# Holds harness.db (SQLite, WAL) and the sessions/ disk mirror.
# DEEPSEEK_DATA_DIR=data
# readonly, default, or full — see docs/TOOLS.md.
# DEEPSEEK_PERMISSION_MODE=default
# DEEPSEEK_MAX_SUB_TURNS=100

# NATS. `docker compose up -d` starts JetStream on the ports below.
# NATS_URL=nats://127.0.0.1:4222
# Host port overrides for docker-compose.yml. Set these if another project on
# this machine already binds the NATS defaults.
# NATS_CLIENT_PORT=4222
# NATS_MONITOR_PORT=8222

# Phase 3: the worker pool (`harness serve`).
# Comma-separated absolute directories a work request's workspace must
# resolve under. Unset means every request is rejected at validation — see
# docs/DESIGN.md §4.10.
# DEEPSEEK_WORKSPACE_ROOTS=/abs/path/to/workspaces
# Also the WORK consumer's MaxAckPending (docs/DESIGN.md §4.10).
# DEEPSEEK_WORKER_POOL_SIZE=4
# Bounds a work request's run when it omits deadline_ms.
# DEEPSEEK_DEFAULT_DEADLINE_MS=1800000
# Per-model concurrent-request ceilings, shared across the pool
# (docs/MODELS.md, "Concurrency is per-model and account-wide").
# DEEPSEEK_MODEL_CONCURRENCY_PRO=500
# DEEPSEEK_MODEL_CONCURRENCY_FLASH=2500
